{% assign repo_parts = include.repository | split: '/' %}
{% assign repo_owner = repo_parts.first %}
{% assign stats_username = site.data.repositories.github_users.first %}
{% assign show_owner = repo_owner != stats_username %}

<a
  class="repo-stats-card"
  href="https://github.com/{{ include.repository }}"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Open {{ include.repository }} on GitHub"
>
  <img
    class="only-light"
    src="{{ site.external_services.github_stats_extended_url }}/api/pin/?username={{ stats_username }}&repo={{ include.repository }}&show_owner={{ show_owner }}&description_lines_count={{ site.data.repositories.repo_description_lines_max }}&theme={{ site.repo_theme_light }}&bg_color={{ site.repo_stats.light.bg_color }}&title_color={{ site.repo_stats.light.title_color }}&text_color={{ site.repo_stats.light.text_color }}&icon_color={{ site.repo_stats.light.icon_color }}&border_color={{ site.repo_stats.light.border_color }}&border_radius=3"
    alt="GitHub repository {{ include.repository }}"
    loading="lazy"
  >
  <img
    class="only-dark"
    src="{{ site.external_services.github_stats_extended_url }}/api/pin/?username={{ stats_username }}&repo={{ include.repository }}&show_owner={{ show_owner }}&description_lines_count={{ site.data.repositories.repo_description_lines_max }}&theme={{ site.repo_theme_dark }}&bg_color={{ site.repo_stats.dark.bg_color }}&title_color={{ site.repo_stats.dark.title_color }}&text_color={{ site.repo_stats.dark.text_color }}&icon_color={{ site.repo_stats.dark.icon_color }}&border_color={{ site.repo_stats.dark.border_color }}&border_radius=3"
    alt="GitHub repository {{ include.repository }}"
    loading="lazy"
  >
</a>
