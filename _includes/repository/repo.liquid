{% assign repo_url = include.repository | split: '/' %}
{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}

<a class="repo-card" href="https://github.com/{{ include.repository }}" target="_blank" rel="noopener noreferrer" aria-label="GitHub repository {{ include.repository }}">
  <div class="repo-card__icon" aria-hidden="true">
    <i class="fa-brands fa-github"></i>
  </div>
  <div class="repo-card__body">
    {% if show_owner %}
      <div class="repo-card__owner">{{ repo_url.first }}</div>
    {% endif %}
    <div class="repo-card__name">{{ repo_url[1] }}</div>
  </div>
  <div class="repo-card__arrow" aria-hidden="true">
    <i class="fa-solid fa-arrow-up-right-from-square"></i>
  </div>
</a>
