{% assign username = include.username %}

<div class="repo-stat-cards">
  <a
    class="repo-stats-card"
    href="https://github.com/{{ username }}"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Open {{ username }}'s GitHub profile"
  >
    <img
      class="only-light"
      src="{{ site.external_services.github_stats_extended_url }}/api/?username={{ username }}&show_icons=true&include_all_commits=true&hide_rank=true&disable_animations=true&custom_title=GitHub%20activity&theme={{ site.repo_theme_light }}&bg_color={{ site.repo_stats.light.bg_color }}&title_color={{ site.repo_stats.light.title_color }}&text_color={{ site.repo_stats.light.text_color }}&icon_color={{ site.repo_stats.light.icon_color }}&border_color={{ site.repo_stats.light.border_color }}&border_radius=3"
      alt="GitHub activity for {{ username }}"
      loading="lazy"
    >
    <img
      class="only-dark"
      src="{{ site.external_services.github_stats_extended_url }}/api/?username={{ username }}&show_icons=true&include_all_commits=true&hide_rank=true&disable_animations=true&custom_title=GitHub%20activity&theme={{ site.repo_theme_dark }}&bg_color={{ site.repo_stats.dark.bg_color }}&title_color={{ site.repo_stats.dark.title_color }}&text_color={{ site.repo_stats.dark.text_color }}&icon_color={{ site.repo_stats.dark.icon_color }}&border_color={{ site.repo_stats.dark.border_color }}&border_radius=3"
      alt="GitHub activity for {{ username }}"
      loading="lazy"
    >
  </a>

  <a
    class="repo-stats-card"
    href="https://github.com/{{ username }}?tab=repositories"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Open {{ username }}'s GitHub repositories"
  >
    <img
      class="only-light"
      src="{{ site.external_services.github_stats_extended_url }}/api/top-langs/?username={{ username }}&layout=compact&langs_count=8&theme={{ site.repo_theme_light }}&bg_color={{ site.repo_stats.light.bg_color }}&title_color={{ site.repo_stats.light.title_color }}&text_color={{ site.repo_stats.light.text_color }}&icon_color={{ site.repo_stats.light.icon_color }}&border_color={{ site.repo_stats.light.border_color }}&border_radius=3"
      alt="Top programming languages for {{ username }}"
      loading="lazy"
    >
    <img
      class="only-dark"
      src="{{ site.external_services.github_stats_extended_url }}/api/top-langs/?username={{ username }}&layout=compact&langs_count=8&theme={{ site.repo_theme_dark }}&bg_color={{ site.repo_stats.dark.bg_color }}&title_color={{ site.repo_stats.dark.title_color }}&text_color={{ site.repo_stats.dark.text_color }}&icon_color={{ site.repo_stats.dark.icon_color }}&border_color={{ site.repo_stats.dark.border_color }}&border_radius=3"
      alt="Top programming languages for {{ username }}"
      loading="lazy"
    >
  </a>
</div>
