<a class="repo-user-card" href="https://github.com/{{ include.username }}" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile {{ include.username }}">
  <img class="repo-user-card__avatar" src="https://github.com/{{ include.username }}.png?size=120" alt="" loading="lazy" width="72" height="72">
  <div class="repo-user-card__body">
    <div class="repo-user-card__label">GitHub</div>
    <div class="repo-user-card__handle">@{{ include.username }}</div>
  </div>
  <div class="repo-user-card__icon" aria-hidden="true">
    <i class="fa-brands fa-github"></i>
  </div>
</a>
