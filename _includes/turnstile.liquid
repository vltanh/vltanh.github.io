{% comment %}
  Cloudflare Turnstile widget (client-side).
  Place inside a <form> so cf-turnstile-response token rides along on submit.
  Pair with /api/turnstile-verify Pages Function on the server.

  Params:
    theme       — auto | light | dark           (default: site config)
    size        — normal | flexible | compact   (default: site config)
    action      — string label, see Cloudflare docs (optional)
    callback    — JS function name on success (optional)
    appearance  — always | execute | interaction-only (optional)
{% endcomment %}
{% if site.turnstile.enabled and site.turnstile.site_key %}
  <div
    class="cf-turnstile"
    data-sitekey="{{ site.turnstile.site_key }}"
    data-theme="{{ include.theme | default: site.turnstile.theme | default: 'auto' }}"
    data-size="{{ include.size | default: site.turnstile.size | default: 'normal' }}"
    {% if include.action %}data-action="{{ include.action }}"{% endif %}
    {% if include.callback %}data-callback="{{ include.callback }}"{% endif %}
    {% if include.appearance %}data-appearance="{{ include.appearance }}"{% endif %}
  ></div>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
{% endif %}
