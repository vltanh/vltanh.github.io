{% comment %}
  Cloudflare Turnstile widget. Place inside <form> to attach the
  cf-turnstile-response token. api.js loaded once via scripts.liquid.
  Params: theme, size, action, callback, appearance — see Cloudflare docs.
{% endcomment %}
{% if site.turnstile.enabled and site.turnstile.site_key %}
  <div
    class="cf-turnstile"
    data-sitekey="{{ site.turnstile.site_key }}"
    data-theme="{{ include.theme | default: site.turnstile.theme | default: 'auto' }}"
    data-size="{{ include.size | default: site.turnstile.size | default: 'normal' }}"
    {% if include.action %}data-action="{{ include.action }}"{% endif %}
    {% if include.callback %}data-callback="{{ include.callback }}"{% endif %}
    {% if include.appearance %}data-appearance="{{ include.appearance }}"{% endif %}
  ></div>
{% endif %}
