{% comment %}
  Unified work and research entry renderer for RenderCV and JSON Resume data.
{% endcomment %}

<ul class="cv-entries">
  {% for entry in entries %}
    {% capture start_date %}{% if entry.start_date %}{{ entry.start_date }}{% elsif entry.startDate %}{{ entry.startDate }}{% endif %}{% endcapture %}
    {% capture end_date %}{% if entry.end_date %}{{ entry.end_date }}{% elsif entry.endDate %}{{ entry.endDate }}{% endif %}{% endcapture %}
    {% assign start_date = start_date | strip %}
    {% assign end_date = end_date | strip %}

    {% if start_date != '' %}
      {% assign start_year = start_date | split: '-' | first %}
      {% if end_date != '' %}
        {% assign end_year = end_date | split: '-' | first %}
        {% if start_year == end_year %}
          {% assign date = start_year %}
        {% else %}
          {% assign date = start_year | append: ' - ' | append: end_year %}
        {% endif %}
      {% else %}
        {% assign date = start_year | append: ' - Present' %}
      {% endif %}
    {% else %}
      {% assign date = '' %}
    {% endif %}

    {% capture company_name %}{% if entry.name %}{{ entry.name }}{% elsif entry.company %}{{ entry.company }}{% elsif entry.organization %}{{ entry.organization }}{% endif %}{% endcapture %}
    {% assign company_name = company_name | strip %}

    <li class="cv-entry">
      <div class="cv-entry__aside">
        {% if date != '' -%}
          <time class="cv-entry__date">{{ date }}</time>
        {%- endif %}
        {% if entry.location %}
          <p class="cv-entry__location"><i class="fa-solid fa-location-dot" aria-hidden="true"></i>{{ entry.location }}</p>
        {% endif %}
      </div>
      <div class="cv-entry__main">
        {% if entry.position %}
          <h3 class="cv-entry__title">{{ entry.position }}</h3>
        {% endif %}
        {% if company_name != '' %}
          <p class="cv-entry__organization">
            {% if entry.url -%}
              <a href="{{ entry.url }}">{{ company_name }}</a>
            {%- else -%}
              {{- company_name -}}
            {%- endif %}
          </p>
        {% endif %}
        {% if entry.topic or entry.advisor %}
          <dl class="cv-entry__facts">
            {% if entry.topic %}
              <div>
                <dt>Topic</dt>
                <dd>{{ entry.topic }}</dd>
              </div>
            {% endif %}
            {% if entry.advisor %}
              <div>
                <dt>Advisor</dt>
                <dd>{{ entry.advisor }}</dd>
              </div>
            {% endif %}
          </dl>
        {% elsif entry.summary %}
          <p class="cv-entry__detail">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
