<ul class="cv-talks">
  {% for entry in entries %}
    {% assign talk_title = entry.title | default: entry.name %}
    <li class="cv-talk">
      {% if entry.date %}
        <time class="cv-talk__year" datetime="{{ entry.date }}">{{ entry.date | date: '%Y' }}</time>
      {% endif %}
      <div class="cv-talk__content">
        {% if talk_title %}
          {% if entry.url %}
            <h4 class="cv-talk__title">
              <a href="{{ entry.url }}">{{ talk_title }}</a>
            </h4>
          {% else %}
            <h4 class="cv-talk__title">{{ talk_title }}</h4>
          {% endif %}
        {% endif %}
        {% if entry.summary %}
          <p class="cv-talk__venue">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
        {% endif %}
        {% if entry.date or entry.location %}
          <div class="cv-talk__meta">
            {% if entry.date %}
              <span>
                <i class="fa-solid fa-calendar-day" aria-hidden="true"></i>
                <time datetime="{{ entry.date }}">{{ entry.date | date: '%B %-d, %Y' }}</time>
              </span>
            {% endif %}
            {% if entry.location %}
              <span>
                <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                {{ entry.location }}
              </span>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
