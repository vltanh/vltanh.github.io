{% comment %}
  Unified awards entry renderer for RenderCV and JSON Resume data.
{% endcomment %}

<ul class="cv-entries">
  {% for entry in entries %}
    {% assign award_title = entry.title | default: entry.name %}
    <li class="cv-entry">
      <div class="cv-entry__aside">
        {% if entry.date -%}
          <time class="cv-entry__date">{{ entry.date | split: '-' | first }}</time>
        {%- endif %}
      </div>
      <div class="cv-entry__main">
        {% if award_title %}
          <h3 class="cv-entry__title">
            {% if entry.url -%}
              <a href="{{ entry.url }}">{{ award_title }}</a>
            {%- else -%}
              {{- award_title -}}
            {%- endif %}
          </h3>
        {% endif %}
        {% if entry.awarder %}
          <p class="cv-entry__organization">{{ entry.awarder }}</p>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
