{% comment %}
  Overrides al_folio_core's wrapper: al_math only checks site.enable_math, so honour page.math as distill_scripts.liquid does.
{% endcomment %}
{% if page.math and site.enable_math != true %}
  <script
    defer
    type="text/javascript"
    id="MathJax-script"
    src="{{ site.third_party_libraries.mathjax.url.js }}"
    integrity="{{ site.third_party_libraries.mathjax.integrity.js }}"
    crossorigin="anonymous"
  ></script>
  <script defer src="{{ '/assets/al_math/js/mathjax-setup.js' | relative_url }}"></script>
{% endif %}
{% al_math_scripts %}
